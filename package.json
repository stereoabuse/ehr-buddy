{
  "name": "ehr-buddy",
  "version": "0.3.6",
  "description": "Minimal local EHR for solo therapy practice",
  "main": "./out/main/index.js",
  "author": "stereoabuse",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "icd10:refresh": "node scripts/fetch-icd10.mjs",
    "postinstall": "install-electron && node scripts/patch-electron-name.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.0",
    "archiver": "^5.3.2",
    "better-sqlite3": "^13.0.3",
    "pdfkit": "^0.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/archiver": "~5.3.4",
    "@types/better-sqlite3": "^7.6.10",
    "@types/pdfkit": "^0.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.3.3",
    "vitest": "^3.2.4"
  }
}
