{
  "name": "ehr-buddy",
  "version": "0.2.0",
  "description": "Minimal local EHR for solo therapy practice",
  "main": "./out/main/index.js",
  "author": "stereoabuse",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "icd10:refresh": "node scripts/fetch-icd10.mjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3 && node scripts/patch-electron-name.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.0",
    "archiver": "^5.3.2",
    "better-sqlite3": "^11.1.2",
    "pdfkit": "^0.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^30.1.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  }
}
